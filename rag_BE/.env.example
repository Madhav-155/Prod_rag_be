# Copy to .env in this directory; use a local development password.
RAG_DATABASE_HOST=127.0.0.1
RAG_DATABASE_PORT=55432
RAG_DATABASE_NAME=rag
RAG_DATABASE_USER=rag
RAG_DATABASE_PASSWORD=change-this-local-password

# Relative paths are resolved from rag_BE, regardless of process working directory.
RAG_DATA_DIR=../.local-data

# Resource limits and crash recovery
RAG_MAX_UPLOAD_BYTES=26214400
RAG_JOB_MAX_ATTEMPTS=3
RAG_JOB_LEASE_SECONDS=60
RAG_WORKER_POLL_SECONDS=2

# Stage 3: bounded PDF/TXT/Markdown processing
RAG_PREPROCESS_TIMEOUT_SECONDS=120
RAG_PREPROCESS_MAX_PAGES=200
RAG_PREPROCESS_MAX_CHARS=2000000
RAG_PREPROCESS_MAX_BLOCKS=20000
RAG_CHUNK_MAX_CHARS=1800
RAG_CHUNK_OVERLAP_CHARS=160

# Stage 4: an already-installed LOCAL model; no download or remote fallback
RAG_EMBEDDING_URL=http://127.0.0.1:11434
RAG_EMBEDDING_MODEL=embeddinggemma:latest
RAG_EMBEDDING_HTTP_TIMEOUT=60
RAG_INDEX_TIMEOUT_SECONDS=300

# Stage 6: local grounded generation; provision models explicitly
RAG_GENERATION_PROVIDER=ollama
RAG_GENERATION_URL=http://127.0.0.1:11434
RAG_GENERATION_MODEL=qwen3:1.7b
RAG_GENERATION_HTTP_TIMEOUT=180

# Remote inference is disabled. Before enabling: review data policy/retention,
# choose a compatible model, supply a server-only secret, and set a finite call cap.
# This cap is per API process lifetime, not a durable monetary/account-wide budget.
RAG_REMOTE_GENERATION_ENABLED=false
RAG_REMOTE_DATA_POLICY_REVIEWED=false
RAG_REMOTE_KILL_SWITCH=true
RAG_REMOTE_CALL_LIMIT=0
# RAG_OPENAI_MODEL=your-explicit-model-id
# RAG_OPENAI_API_KEY=your-server-only-secret
